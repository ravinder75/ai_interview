APP_NAME=Interview Coach AI
ENVIRONMENT=development

DATABASE_URL=sqlite:///./interview_coach.db

AI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=YOUR_NEW_ROTATED_KEY
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001:free

CORS_ORIGINS=http://localhost:5173

# IMPORTANT: Generate a strong random secret for production
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# Google OAuth 2.0 (leave empty to disable Google login)
# See README for Google Cloud Console setup instructions
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8005/api/auth/google/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Password reset token expiry in minutes
PASSWORD_RESET_EXPIRE_MINUTES=60
