{
  "name": "interview-bit-desktop",
  "version": "1.0.0",
  "description": "100% Anti-Screen-Share Desktop Assistant for Interview Bit",
  "homepage": "http://localhost:5173",
  "main": "main.js",
  "author": {
    "name": "Antigravity AI Team",
    "email": "support@interviewbit.ai"
  },
  "scripts": {
    "start": "electron . --no-sandbox",
    "build:linux": "electron-builder --linux AppImage",
    "build:win": "electron-builder --win"
  },
  "keywords": ["interview", "ai", "stealth", "electron"],
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.interviewbit.assistant",
    "productName": "Interview Bit Assistant",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "maintainer": "support@interviewbit.ai"
    },
    "win": {
      "target": ["portable"]
    }
  }
}
